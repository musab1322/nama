{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    { "path": "/api/cron/domains", "schedule": "0 5 * * *" },
    { "path": "/api/cron/billing", "schedule": "0 6 * * *" }
  ]
}
