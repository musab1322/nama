# ---- Platform Supabase (this SaaS) ----
NEXT_PUBLIC_SUPABASE_URL=https://<platform-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only

# ---- Claude ----
ANTHROPIC_API_KEY=

# ---- Vercel (hosting generated apps) ----
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_...
VERCEL_WEBHOOK_SECRET=                         # from the Vercel webhook you create
PLATFORM_ROOT_DOMAIN=yourplatform.app          # wildcard *.yourplatform.app on Vercel

# ---- Supabase Management API (one Supabase project per generated app) ----
SUPABASE_MANAGEMENT_TOKEN=sbp_...
SUPABASE_APPS_ORG_SLUG=
SUPABASE_APPS_REGION_GROUP=emea                # americas | emea | apac
SUPABASE_MIGRATIONS_ENDPOINT=query             # "migrations" once Supabase grants partner access

# ---- Expo / EAS (worker) ----
EXPO_TOKEN=                                    # robot user token of the platform Expo org
EXPO_OWNER=                                    # Expo org that owns every EAS project
EXPO_WEBHOOK_SECRET=
BUNDLE_ID_PREFIX=app.yourplatform

# ---- Cron + worker ----
CRON_SECRET=
WORKER_CONCURRENCY=2
